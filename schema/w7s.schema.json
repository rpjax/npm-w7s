{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/rpjax/npm-w7s/main/schema/w7s.schema.json",
  "title": "w7s manifest",
  "description": "Three keys only: gecko, toolchain and modifications. Unknown keys are errors.",
  "type": "object",
  "required": ["gecko", "toolchain", "modifications"],
  "additionalProperties": false,
  "properties": {
    "gecko": { "$ref": "#/$defs/gecko" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "modifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/modification" }
    }
  },
  "$defs": {
    "gecko": {
      "type": "object",
      "required": ["version", "repository", "commit"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Directory name under .w7s/gecko and out. A label; never parsed."
        },
        "repository": { "type": "string", "minLength": 1 },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full 40-hex commit. Verified with git rev-parse after materializing."
        }
      }
    },
    "toolchain": {
      "type": "object",
      "required": ["target", "baseImage", "aptPackages", "rustVersion", "sccacheVersion"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Compilation target name. Used in out/<version>/<target>."
        },
        "baseImage": { "type": "string", "minLength": 1 },
        "aptPackages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rustVersion": { "type": "string", "minLength": 1 },
        "sccacheVersion": { "type": "string", "minLength": 1 },
        "extraCommands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Additional RUN lines, appended last, in order, verbatim."
        },
        "mozconfigOptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "mozconfig lines, verbatim and in order. MOZ_OBJDIR is written by w7s."
        }
      }
    },
    "fileMapping": {
      "type": "object",
      "required": ["localPath", "geckoPath"],
      "additionalProperties": false,
      "properties": {
        "localPath": { "type": "string", "minLength": 1 },
        "geckoPath": { "type": "string", "minLength": 1 }
      }
    },
    "directoryModification": {
      "type": "object",
      "required": ["name", "description", "type", "localPath", "geckoPath", "replacesGeckoSource"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "type": { "const": "directory" },
        "localPath": { "type": "string", "minLength": 1 },
        "geckoPath": { "type": "string", "minLength": 1 },
        "replacesGeckoSource": { "type": "boolean" }
      }
    },
    "filesModification": {
      "type": "object",
      "required": ["name", "description", "type", "files", "replacesGeckoSource"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "type": { "const": "files" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileMapping" } },
        "replacesGeckoSource": { "type": "boolean" }
      }
    },
    "modification": {
      "oneOf": [
        { "$ref": "#/$defs/directoryModification" },
        { "$ref": "#/$defs/filesModification" }
      ]
    }
  }
}
